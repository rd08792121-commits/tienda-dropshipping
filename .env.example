# Required. Your Next Store (YNS) API key — this is what connects the storefront
# to your store's product catalog, cart, checkout and (platform-managed) Stripe
# payments. Get it from your YNS store dashboard.
YNS_API_KEY=your_api_token_here

# Optional overrides — leave unset for a standard YNS-hosted store.
# Points the SDK at a non-default YNS API host (self-hosted / dev deployments only).
# YNS_API_URL=https://your-yns-instance.example.com
# Base URL of your store's tenant on the YNS platform, used to resolve the
# storefront's public subdomain without an extra API round trip.
# NEXT_PUBLIC_YNS_API_TENANT=https://your-store.yns.store
# Canonical public URL of this deployment, used for metadata/Open Graph/sitemap.
# Falls back to the Vercel-provided URL when deployed on Vercel.
# NEXT_PUBLIC_URL=https://your-store-domain.com
