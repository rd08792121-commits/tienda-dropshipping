# Puerto HTTP del servidor
PORT=4000

# Origen permitido para CORS (la URL de tu frontend)
CORS_ORIGIN=http://localhost:3000

# URLs a las que Stripe Checkout redirige tras el pago.
# CHECKOUT_SUCCESS_URL puede incluir {CHECKOUT_SESSION_ID}, que Stripe sustituye automaticamente.
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel

# Ruta del archivo SQLite (se crea automaticamente)
DATABASE_PATH=./data/store.db

# Claves de Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Firma del webhook: la genera `stripe listen --forward-to localhost:4000/api/webhook/stripe`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Moneda por defecto (ISO 4217 en minusculas)
CURRENCY=usd
